# Google Sheets through the Apps Script web app
GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
GOOGLE_SHEETS_API_TOKEN=REPLACE_WITH_THE_SCRIPT_API_TOKEN

# Meta WhatsApp Cloud API. Keep these server-side; do not use NEXT_PUBLIC_ variables.
META_WA_ACCESS_TOKEN=REPLACE_WITH_META_ACCESS_TOKEN
META_WA_PHONE_NUMBER_ID=REPLACE_WITH_PHONE_NUMBER_ID
META_WA_TEMPLATE_NAME=blue_aviso_ganador
META_WA_LANGUAGE_CODE=es_AR
META_WA_PHONE_PREFIX=549
META_WA_API_VERSION=vXX.X
